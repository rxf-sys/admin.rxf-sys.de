# Copy to infrastructure-v2/.env on the v2 LXC. deploy.sh rewrites the two image lines with verified digests.
RXF_SERVER_IMAGE=ghcr.io/rxf-sys/admin-v2-server:staging
RXF_WEB_IMAGE=ghcr.io/rxf-sys/admin-v2-web:staging
RXF_VERSION=staging
# Origin the browser sees; passkeys only work on this hostname.
RXF_PUBLIC_ORIGIN=https://admin.rxf-sys.de
# Address of the cloudflared host (CT 110); only its CF-Connecting-IP header is believed.
RXF_CLOUDFLARED_IP=192.168.2.213
