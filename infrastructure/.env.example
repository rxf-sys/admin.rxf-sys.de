# ------------------------------------------------------------
# rxf-sys admin · backend configuration
# Copy this file to ./.env (next to docker-compose.yml) and fill in.
#
# Everything in this file gets baked into the backend's Settings on
# startup. Anything you can change later from the UI (instance name,
# ntfy push, SMTP report, auto-audit schedule, …) lives in the SQLite
# app_settings table — it intentionally has no .env equivalent so the
# two stores don't fight each other.
# ------------------------------------------------------------

# ============================================================
# Core
# ============================================================
APP_ENV=production
LOG_LEVEL=INFO
# JSON list. The SPA is served from the same origin, so this only
# matters when you ever expose /api/* to a different host.
CORS_ORIGINS=["https://admin.rxf-sys.de"]
# When false, every request resolves to a synthetic admin identity —
# local development only. Keep true in production.
AUTH_ENABLED=true

# ============================================================
# Account authentication
# ============================================================
# Session-cookie lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Must be true in production (HTTPS). Set false only for local http://.
SESSION_COOKIE_SECURE=true
# Bootstrap the first admin account when the users table is empty. After
# that login, change the password in 'Einstellungen' and create the real
# accounts in the 'Konten' tab. Empty password skips bootstrap.
BOOTSTRAP_ADMIN_USER=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login

# ============================================================
# Proxmox VE
# ============================================================
# Datacenter -> Permissions -> Users -> Add 'admin-dashboard@pve'
# Datacenter -> Permissions -> API Tokens -> Add for that user, name 'api'
# Datacenter -> Permissions -> Permissions -> Path '/', role 'PVEAuditor'
PROXMOX_HOST=192.168.2.200
PROXMOX_PORT=8006
PROXMOX_NODE=rxf-sys
PROXMOX_TOKEN_ID=admin-dashboard@pve!api
PROXMOX_TOKEN_SECRET=00000000-0000-4000-8000-000000000000
PROXMOX_VERIFY_TLS=false

# ============================================================
# Proxmox Backup Server
# ============================================================
# Same idea. Token needs Datastore.Audit on the datastore;
# Datastore.Verify additionally if you want the Verify-button to work.
PBS_HOST=192.168.2.209
PBS_PORT=8007
PBS_TOKEN_ID=admin-dashboard@pbs!api
PBS_TOKEN_SECRET=11111111-1111-4111-8111-111111111111
PBS_DATASTORE=backups
PBS_VERIFY_TLS=false

# ============================================================
# Cloudflare API
# ============================================================
# https://dash.cloudflare.com/profile/api-tokens -> Create Custom Token
# Scopes:
#   Account -> Cloudflare Tunnel       · Read
#   Zone    -> DNS                     · Read
#   Zone    -> SSL and Certificates    · Read
#   Zone    -> Analytics               · Read   (Requests-Card)
CF_ACCOUNT_ID=00000000000000000000000000000000
CF_ZONE_ID=00000000000000000000000000000000
CF_ZONE_NAME=rxf-sys.de
CF_API_TOKEN=cf_token_replace_me_with_real_value_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_TUNNEL_ID=00000000-0000-4000-8000-000000000000

# ============================================================
# UniFi (UCG-Ultra local API)
# ============================================================
# PREFERRED (UniFi OS 4.x+): Integration API key
#   Network -> Settings -> Control Plane -> Integrations -> Add API Key
#   Trade-off: no live WAN throughput, no per-device CPU/RAM.
#
# FALLBACK (older firmware OR if you need live throughput):
#   Settings -> Admins -> Create New Admin (Local Access only, read-only)
#   Cloud SSO accounts will NOT work.
UNIFI_HOST=192.168.2.1
UNIFI_PORT=443
UNIFI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_TLS=false

# ============================================================
# Probe targets
# ============================================================
# Maps service id -> internal LAN URL for the INT reachability check.
# Public host is derived as <id>.<CF_ZONE_NAME>.
# JSON object format. Leave unset to keep the built-in defaults in
# app/config.py.
# PROBE_TARGETS={"vault":"http://192.168.2.203","cloud":"http://192.168.2.206:11000"}
PROBE_TIMEOUT_S=4.0
PROBE_INTERVAL_S=30

# ============================================================
# Cache TTLs (seconds)
# ============================================================
CACHE_TTL_SYSTEM=15
CACHE_TTL_SERVICES=30
CACHE_TTL_TUNNEL=30
CACHE_TTL_PBS=60
CACHE_TTL_UNIFI=30
CACHE_TTL_CERTS=600
CACHE_TTL_CF_ANALYTICS=300
CACHE_TTL_GEOIP=21600

# ============================================================
# IP Geolocation
# ============================================================
# Looks the WAN IP up at ipapi.co (free tier, no auth) when UniFi
# doesn't surface the ISP name. The WAN IP is already public so no
# privacy regression. Set false to disable.
GEOIP_ENABLED=true

# ============================================================
# Storage / history (SQLite)
# ============================================================
# Path inside the backend container. docker-compose mounts a named
# volume on /data so the default Just Works. Empty string disables
# all history (probe / host / guest / network metrics).
STORAGE_DB_PATH=/data/rxf-admin.db
HISTORY_RETENTION_DAYS=7
HISTORY_CLEANUP_INTERVAL_S=3600
# Host + guest + network sampler tick. Sub-60 turns trends choppy;
# 60 is the sweet spot. 0 disables the sampler entirely.
METRICS_SAMPLE_INTERVAL_S=60

# ============================================================
# Audit script
# ============================================================
# When AUDIT_SSH_HOST is set, the script runs on that host via
# 'ssh <user>@<host> bash -s' — gives the script access to systemctl,
# smartctl, host iptables. Leave empty to run inside the container
# (5 of 12 checks skip with a hint then).
AUDIT_SSH_HOST=192.168.2.200
AUDIT_SSH_USER=root
AUDIT_SSH_KEY_PATH=/data/id_audit
# Maximum runtime per audit, before the subprocess is killed.
AUDIT_TIMEOUT_S=180
# Optional override: full path to a custom audit script. Empty uses
# the bundled scripts/audit.sh inside the image.
AUDIT_SCRIPT_PATH=

# ============================================================
# Webhook notifications (optional)
# ============================================================
# Discord / Slack-compatible incoming webhook. Empty = disabled.
# ntfy push + weekly SMTP report are configured from the UI, not here.
# Discord:  https://discord.com/api/webhooks/<id>/<token>
# Slack:    https://hooks.slack.com/services/<...>   (Discord-shape OK)
NOTIFY_WEBHOOK_URL=
# Anti-flap: service must stay degraded this many seconds before fire.
NOTIFY_SERVICE_THRESHOLD_S=180
NOTIFY_CERT_DAYS=14
NOTIFY_INTERVAL_S=60
