{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["frontend/**"],
  "workspaces": {
    ".": {
      "project": ["*.ts"]
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "e2e": {
      "project": ["*.ts", "tests/**/*.ts"]
    },
    "packages/ui": {
      "entry": [],
      "project": []
    }
  },
  "ignoreBinaries": ["openssl"]
}
